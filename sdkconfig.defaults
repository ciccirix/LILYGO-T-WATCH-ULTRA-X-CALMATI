# Custom sdkconfig for the twatch_ultra env (branch: esp-sr-poc).
#
# arduino-esp32 3.3.11 (via pioarduino platform) defaults to NimBLE for BLE.
# Our fork uses Bluedroid heavily (ble_scan_manager, airtag/flipper/skimmer
# detectors, phone_link GATT server, evil_twin_verify). Flip the switch.
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=n
CONFIG_BT_CONTROLLER_ENABLED=y
CONFIG_BT_BLE_ENABLED=y

# Suppress the legacy I2S deprecation warning that turns into an error when
# both driver/i2s.h (legacy) and driver/i2s_std.h (new) are pulled in.
CONFIG_I2S_SUPPRESS_DEPRECATE_WARN=y
